#!/bin/sh
# Stub wp-cli: active plugins from $PLUGINS (comma-separated), users from $USERS (JSON);
# everything else fails fast.
case "$*" in
  *"plugin list --format=json"*)
    echo "$PLUGINS" | awk -F, '{ printf "["; for (i = 1; i <= NF; i++) printf "%s{\"name\":\"%s\",\"status\":\"active\",\"update\":\"none\",\"version\":\"1.0\"}", (i > 1 ? "," : ""), $i; print "]" }';;
  *"user list"*) echo "$USERS";;
  *) exit 1;;
esac
